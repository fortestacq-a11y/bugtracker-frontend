# ---- build output ----------------------------------------------------------
dist/
.vite/

# ---- dependencies ----------------------------------------------------------
node_modules/

# ---- environment / secrets -------------------------------------------------
# The bundle talks to a relative /api path, so there are no build-time or
# client-side API variables to commit. Anything here is a local-only override.
.env
.env.*
!.env.example

# ---- logs ------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- editor / OS -----------------------------------------------------------
.idea/
.vscode/
*.iml
*.swp
.DS_Store
Thumbs.db

# ---- caches ----------------------------------------------------------------
.cache/
